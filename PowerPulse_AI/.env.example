# =====================================================================
# POWERPULSE - ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================
# Copy this file to '.env' and fill in your connection details:
#   cp .env.example .env
# =====================================================================

# Database Engine Selection
# Options: 'mongodb' or 'sqlite'
DB_TYPE=mongodb

# ---------------------------------------------------------------------
# MONGODB CONFIGURATION
# ---------------------------------------------------------------------
# MongoDB Connection URI:
# Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# Local: mongodb://localhost:27017
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority

# MongoDB Database Name
MONGODB_DB_NAME=powerpulse_db

# MongoDB Collection Names
MONGODB_USERS_COLLECTION=users
MONGODB_BATTERIES_COLLECTION=battery_records
MONGODB_ASSESSMENTS_COLLECTION=assessments

# MongoDB Timeout in Milliseconds
MONGODB_TIMEOUT_MS=5000

# ---------------------------------------------------------------------
# SQLITE BACKUP / FALLBACK CONFIGURATION
# ---------------------------------------------------------------------
SQLITE_DB_PATH=database/powerpulse.db

# ---------------------------------------------------------------------
# APPLICATION SETTINGS
# ---------------------------------------------------------------------
APP_ENV=development
PORT=8501

